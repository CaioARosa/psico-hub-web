{
  "name": "lays-landing",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "render:story": "node scripts/render-story.mjs",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project demo-psico-hub \"node --test test/firestore-rules/rules.test.mjs\"",
    "deploy": "ng build && npx firebase-tools deploy --only hosting",
    "deploy:backend": "npx firebase-tools deploy --only run",
    "deploy:all": "ng build && npx firebase-tools deploy --only run,hosting"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ng-icons/core": "^33.1.0",
    "@ng-icons/lucide": "^33.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.3.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
