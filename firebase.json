{
  "hosting": {
    "public": "dist/lays-landing/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "psico-hub-backend",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  },
  "run": {
    "serviceId": "psico-hub-backend",
    "region": "southamerica-east1",
    "rootDir": "server",
    "ignore": [
      "node_modules",
      ".git",
      ".env"
    ]
  }
}
